# TraceGate Edge contains synthetic demo data only. Do not put credentials here.
TRACEGATE_DATA_DIR=./data
TRACEGATE_HOST=0.0.0.0
TRACEGATE_PORT=8080

# When both services run directly on one machine, use the loopback URL below.
# Docker Compose overrides it with the mock-mes service name.
TRACEGATE_MES_URL=http://127.0.0.1:8081/api/v1/trace-events
TRACEGATE_MOCK_MES_HOST=127.0.0.1
TRACEGATE_MOCK_MES_PORT=8081

TRACEGATE_OUTBOX_INTERVAL=1
TRACEGATE_OUTBOX_TIMEOUT=4
TRACEGATE_OUTBOX_MAX_ATTEMPTS=8
TRACEGATE_OUTBOX_BATCH=20

# Host-side ports used by docker-compose.yml.
TRACEGATE_PUBLISHED_PORT=8080
TRACEGATE_MOCK_PUBLISHED_PORT=8081
